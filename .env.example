# Salin file ini jadi ".env" lalu isi nilainya masing-masing.
# JANGAN PERNAH commit file ".env" (isinya rahasia) ke Git — pastikan
# ".env" sudah ada di .gitignore.

# Ambil di Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=isi-dengan-service_role-key-BUKAN-anon-key

# Kunci rahasia untuk session Flask - isi bebas, string acak yang panjang
FLASK_SECRET_KEY=ganti-dengan-string-acak-yang-panjang-dan-rahasia
